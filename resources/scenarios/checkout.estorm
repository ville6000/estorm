# Web shop checkout
! Do we support guest checkout?

{Shopping cart}
Customer: Place order -> (Order) -> OrderPlaced
  then Reserve stock -> (Inventory) -> StockReserved
    then Charge card -> [Stripe] -> PaymentCaptured
      ! What if the charge succeeds but our callback times out?
      then Confirm order -> (Order) -> OrderConfirmed
        then Send confirmation email -> [SendGrid] -> ConfirmationEmailSent
  then Calculate shipping cost -> [Posti] -> ShippingCostCalculated

{Orders to pack}
Warehouse worker: Pack order -> (Order) -> OrderPacked
  then Book pickup -> [Posti] -> PickupBooked

Customer: Cancel order -> (Order) -> OrderCancelled
  ! Can an order be cancelled after it is packed?
  then Release stock -> (Inventory) -> StockReleased
  then Refund payment -> [Stripe] -> PaymentRefunded
