{
  "name": "@villev/estorm",
  "version": "0.8.0",
  "description": "A plain-text notation for Event Storming boards, rendered to SVG",
  "keywords": [
    "event-storming",
    "ddd",
    "domain-driven-design",
    "diagram",
    "svg"
  ],
  "license": "MIT",
  "author": "Ville Viklund",
  "homepage": "https://ville6000.github.io/estorm/",
  "bugs": "https://github.com/ville6000/estorm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ville6000/estorm.git"
  },
  "type": "module",
  "bin": {
    "estorm": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/web",
    "GRAMMAR.md",
    "EDITORS.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "estorm": "node src/cli.ts",
    "examples": "node scripts/render-examples.ts",
    "preversion": "node scripts/check-release.ts && npm run check",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
